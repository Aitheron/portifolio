{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": ".test-dist",
    "plugins": [],
    "rootDir": "src",
    "target": "ES2020",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/*.test.ts",
    "src/store/*.test.ts"
  ]
}
